# Android / Gradle
.gradle/
build/
local.properties
*.iml
.idea/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.keystore
*.jks

# Rust
target/

# Python
__pycache__/
*.pyc

# Large third-party binaries and downloads: commit the fetch/build script, never the files
**/third_party_bin/
**/downloads/
*.exe
*.msi
*.7z
*.tar.*
*.img

# OS / editors
.DS_Store
Thumbs.db
.vscode/

# Evidence images and videos stay out of git; describe them in text instead
evidence/**/*.png
evidence/**/*.jpg
evidence/**/*.mp4
# Raw device dumps stay local; commit short excerpts with the key lines instead
evidence/**/*_logcat.txt
evidence/**/*_activities.txt
evidence/**/*_windows.txt
evidence/**/*_display.txt

# Phase 2: built and downloaded pieces (rebuilt by android/win86/fetch-box64.sh; runtime data is fetched by the app)
android/app/src/main/jniLibs/
android/win86/vendor/
android/win86/guestsh/*
!android/win86/guestsh/*.c
