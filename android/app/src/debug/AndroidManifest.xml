<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <!-- Test-only action channel (B-025): debug builds only, guarded by
      android.permission.DUMP so only adb's shell (and root) can send it.
      Third-party apps cannot hold DUMP. The release build has no receiver. -->
 <application>
  <receiver
      android:name=".HarnessReceiver"
      android:exported="true"
      android:permission="android.permission.DUMP"/>
  <!-- Debug builds keep the harness one tap away; release builds have only HomeActivity
       with the LAUNCHER category (UX_AUDIT P6). -->
  <activity android:name=".HarnessActivity" android:exported="true">
   <intent-filter>
    <action android:name="android.intent.action.MAIN"/>
    <category android:name="android.intent.category.LAUNCHER"/>
   </intent-filter>
  </activity>
 </application>
</manifest>
