<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 3 (ARCHITECTURE H8): code-server listens on 127.0.0.1 ONLY, and both the app's own
  health check and the WebView talk to it over plain HTTP on the loopback interface.

  Cleartext is opened for exactly 127.0.0.1 and localhost and for nothing else: every other
  request keeps Android's targetSdk-36 default (no cleartext at all). No domain, no
  user-installed CA or debug-override section is added here, so the release behaviour is
  the same as the debug behaviour.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
