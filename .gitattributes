# Store text with LF and check it out with LF, whatever core.autocrlf says.
# Without this, files flip between CRLF and LF and show as modified when nothing changed.
* text=auto eol=lf

# Windows scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary
*.png binary
*.jpg binary
*.so binary
*.jar binary
*.ico binary
